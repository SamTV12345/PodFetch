    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "javascript-time-ago": "^2.6.4",
    "lucide-react": "^1.29.0",
    "oidc-client-ts": "^3.5.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
