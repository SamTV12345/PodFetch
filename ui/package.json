{
  "name": "podfetch-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build-github": "tsc && vite build --emptyOutDir --outDir ../static",
    "tsc:watch": "tsc --watch --noEmit",
    "tsc:check": "tsc --noEmit",
